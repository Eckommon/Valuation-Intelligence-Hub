# User-local valuation drafts / 사용자 로컬 가치평가 Draft
/workspace/user_cases/**
!/workspace/user_cases/.gitkeep

# User-local promotion packages / 사용자 로컬 승격 패키지
/workspace/promotion_packages/**
!/workspace/promotion_packages/.gitkeep

# User-local live source snapshots / 사용자 로컬 live source snapshot
/workspace/source_snapshots/**
!/workspace/source_snapshots/.gitkeep

# Python / Python 임시파일
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Local environments / 로컬 환경
.venv/
venv/
