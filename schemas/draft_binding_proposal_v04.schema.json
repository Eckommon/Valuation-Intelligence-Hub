{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eckommon/Valuation-Intelligence-Hub/schemas/draft_binding_proposal_v04.schema.json",
  "title": "WACC-Aware Draft Binding Proposal v0.4",
  "type": "object",
  "required": ["schema_version","status","canonical","target","policy","identity","baseline_context","conflicts","draft_input_matrix","completeness","source_observation_sha256","source_wacc_package_sha256","wacc_package","base_proposal","base_proposal_sha256","proposal_sha256"],
  "properties": {
    "schema_version": {"const":"draft-binding-proposal-v0.4"},
    "status": {"const":"DRAFT_BINDING_PROPOSED"},
    "canonical": {"const":false},
    "target": {"type":"object","required":["draft_schema_version","model"],"properties":{"draft_schema_version":{"const":"draft-case-v0.1"},"model":{"const":"equity_fcff"}},"additionalProperties":false},
    "policy": {
      "type":"object",
      "required":["version","as_of","base_policy_version","direct_bind_requires"],
      "properties": {
        "version":{"const":"evidence-draft-binding-v0.4-wacc"},
        "as_of":{"type":"string","format":"date"},
        "base_policy_version":{"type":"string","minLength":1},
        "direct_bind_requires":{"const":["REVIEWED_ASSUMPTION","FRESH_SOURCE_INPUTS","EXPLICIT_METHOD","HUMAN_REVIEW_ASSERTION","EXACT_SCENARIO_TARGET_SET"]}
      },
      "additionalProperties":false
    },
    "identity":{"type":"object"},
    "baseline_context": {
      "type":"object",
      "required":["wacc_assumption"],
      "properties": {
        "wacc_assumption": {
          "type":"object",
          "required":["metric","value","unit","class","entity","capital_currency","as_of","scenario_names","methodology_version","context_sha256","source_package_sha256","review_assertion_sha256"],
          "properties": {
            "metric":{"const":"wacc_assumption"},
            "value":{"type":"number","exclusiveMinimum":0,"maximum":0.99},
            "unit":{"const":"decimal"},
            "class":{"const":"ASSUMPTION"},
            "context_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
            "source_package_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
            "review_assertion_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "conflicts":{"type":"object"},
    "draft_input_matrix": {
      "type":"array","minItems":13,"maxItems":13,
      "contains": {
        "type":"object",
        "required":["field","state","source_metric","source_class","source_context_sha256","source_package_sha256","review_assertion_sha256","scenario_names"],
        "properties": {
          "field":{"const":"scenario.wacc"},
          "state":{"const":"DIRECT_BIND"},
          "source_metric":{"const":"wacc_assumption"},
          "source_class":{"const":"ASSUMPTION"},
          "source_context_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "source_package_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "review_assertion_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "scenario_names":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      },
      "minContains":1,"maxContains":1
    },
    "completeness":{"type":"object"},
    "source_observation_sha256":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "source_wacc_package_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "wacc_package":{"$ref":"reviewed_wacc_assumption.schema.json"},
    "base_proposal":{"type":"object","required":["schema_version","proposal_sha256"],"properties":{"schema_version":{"enum":["draft-binding-proposal-v0.1","draft-binding-proposal-v0.2","draft-binding-proposal-v0.3"]},"proposal_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "base_proposal_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "proposal_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
