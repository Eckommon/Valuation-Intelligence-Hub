{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eckommon/Valuation-Intelligence-Hub/schemas/draft_binding_proposal_v07.schema.json",
  "title": "Draft Binding Proposal v0.7",
  "type": "object",
  "required": ["schema_version","status","canonical","target","policy","identity","baseline_context","conflicts","draft_input_matrix","completeness","source_observation_sha256","source_market_price_package_sha256","market_price_package","base_proposal","base_proposal_sha256","proposal_sha256"],
  "properties": {
    "schema_version": {"const": "draft-binding-proposal-v0.7"},
    "status": {"const": "DRAFT_BINDING_PROPOSED"},
    "canonical": {"const": false},
    "target": {"type": "object"},
    "policy": {"type": "object", "required": ["version","as_of","base_policy_version","direct_bind_requires"]},
    "identity": {"type": "object"},
    "baseline_context": {"type": "object"},
    "conflicts": {"type": "object"},
    "draft_input_matrix": {"type": "array", "minItems": 13, "maxItems": 13},
    "completeness": {"type": "object"},
    "source_observation_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "source_market_price_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "market_price_package": {"type": "object"},
    "base_proposal": {"type": "object"},
    "base_proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}