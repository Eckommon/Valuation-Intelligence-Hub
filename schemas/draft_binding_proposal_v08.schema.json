{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eckommon/Valuation-Intelligence-Hub/schemas/draft_binding_proposal_v08.schema.json",
  "title": "Draft Binding Proposal v0.8 — Minority Interest",
  "type": "object",
  "required": ["schema_version","status","canonical","target","policy","identity","baseline_context","conflicts","draft_input_matrix","completeness","source_observation_sha256","source_minority_interest_package_sha256","minority_interest_package","base_proposal","base_proposal_sha256","proposal_sha256"],
  "properties": {
    "schema_version": {"const": "draft-binding-proposal-v0.8"},
    "status": {"const": "DRAFT_BINDING_PROPOSED"},
    "canonical": {"const": false},
    "target": {"type": "object", "required": ["draft_schema_version","model"], "properties": {"draft_schema_version":{"const":"draft-case-v0.1"},"model":{"const":"equity_fcff"}}},
    "policy": {"type": "object", "required": ["version","as_of","base_policy_version","direct_bind_requires"], "properties": {"version":{"const":"evidence-draft-binding-v0.8-minority-interest"}}},
    "identity": {"type": "object"},
    "baseline_context": {"type": "object"},
    "conflicts": {"type": "object"},
    "draft_input_matrix": {"type": "array", "minItems": 13, "maxItems": 13},
    "completeness": {"type": "object"},
    "source_observation_sha256": {"type": "array", "items": {"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "source_minority_interest_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "minority_interest_package": {"type": "object"},
    "base_proposal": {"type": "object"},
    "base_proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}