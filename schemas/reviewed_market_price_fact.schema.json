{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eckommon/Valuation-Intelligence-Hub/schemas/reviewed_market_price_fact.schema.json",
  "title": "Reviewed Market Price Fact v0.1",
  "type": "object",
  "required": ["schema_version","status","canonical","class","methodology_version","metric","price","currency","price_basis","quote_type","trading_date","observed_at","as_of","entity","instrument","source","policy","freshness","semantic_boundary","candidate","review_assertion","binding_eligibility","package_sha256"],
  "properties": {
    "schema_version": {"const": "reviewed-market-price-fact-v0.1"},
    "status": {"const": "MARKET_PRICE_FACT_REVIEWED"},
    "canonical": {"const": false},
    "class": {"const": "FACT"},
    "methodology_version": {"const": "market-price-as-traded-v0.1"},
    "metric": {"const": "market_price"},
    "price": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"type": "string"},
    "price_basis": {"const": "AS_TRADED_PER_SHARE"},
    "quote_type": {"enum": ["OFFICIAL_CLOSE","LAST_TRADE"]},
    "trading_date": {"type": "string", "format": "date"},
    "observed_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": "string", "format": "date"},
    "entity": {"type": "object"},
    "instrument": {"type": "object"},
    "source": {"type": "object"},
    "policy": {"type": "object"},
    "freshness": {"type": "object"},
    "semantic_boundary": {"type": "object"},
    "candidate": {"type": "object"},
    "review_assertion": {"type": "object"},
    "binding_eligibility": {"type": "object", "required": ["eligible","reason"]},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}