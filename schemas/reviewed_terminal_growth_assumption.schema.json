{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eckommon/Valuation-Intelligence-Hub/schemas/reviewed_terminal_growth_assumption.schema.json",
  "title": "Reviewed Terminal Growth Assumption v0.1 / 검토완료 영구성장률 가정 v0.1",
  "type": "object",
  "required": ["schema_version", "status", "canonical", "class", "methodology_version", "entity", "capital_currency", "as_of", "scenario_names", "terminal_growth", "nominal_growth_anchor", "reviewed_wacc", "source_wacc_package_sha256", "candidate", "review_assertion", "binding_eligibility", "package_sha256"],
  "properties": {
    "schema_version": {"const": "reviewed-terminal-growth-assumption-v0.1"},
    "status": {"const": "TERMINAL_GROWTH_ASSUMPTION_REVIEWED"},
    "canonical": {"const": false},
    "class": {"const": "ASSUMPTION"},
    "methodology_version": {"const": "terminal-growth-macro-anchor-v0.1"},
    "entity": {"type": "object", "required": ["id", "financial_scope"]},
    "capital_currency": {"type": "string", "minLength": 3, "maxLength": 8},
    "as_of": {"type": "string", "format": "date"},
    "scenario_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "terminal_growth": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": -1}},
    "nominal_growth_anchor": {"type": "number"},
    "reviewed_wacc": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.99},
    "source_wacc_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {"type": "object"},
    "review_assertion": {"type": "object"},
    "binding_eligibility": {
      "type": "object",
      "required": ["eligible", "reason"],
      "properties": {
        "eligible": {"const": true},
        "reason": {"const": "REVIEWED_TERMINAL_GROWTH_ASSUMPTION"}
      },
      "additionalProperties": false
    },
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
