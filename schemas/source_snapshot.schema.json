{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eckommon/Valuation-Intelligence-Hub/schemas/source_snapshot.schema.json",
  "title": "Immutable Live Source Snapshot / 불변 Live Source Snapshot",
  "type": "object",
  "required": ["schema_version", "status", "canonical", "adapter", "source", "request", "response", "raw_text", "snapshot_sha256"],
  "properties": {
    "schema_version": {"const": "source-snapshot-v0.1"},
    "status": {"const": "SOURCE_SNAPSHOT_CAPTURED"},
    "canonical": {"const": false},
    "adapter": {"const": "sec-companyfacts-v0.1"},
    "source": {
      "type": "object",
      "required": ["publisher", "source_type", "tier", "requested_locator", "final_locator"],
      "properties": {
        "publisher": {"const": "U.S. Securities and Exchange Commission"},
        "source_type": {"const": "official_edgar_companyfacts_api"},
        "tier": {"const": "A"},
        "requested_locator": {"type": "string", "format": "uri"},
        "final_locator": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["method", "cik", "user_agent_provided"],
      "properties": {
        "method": {"const": "GET"},
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "user_agent_provided": {"const": true}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["http_status", "content_type", "fetched_at", "body_bytes", "body_sha256", "etag", "last_modified"],
      "properties": {
        "http_status": {"const": 200},
        "content_type": {"type": "string"},
        "fetched_at": {"type": "string"},
        "body_bytes": {"type": "integer", "minimum": 2},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "etag": {"type": ["string", "null"]},
        "last_modified": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "raw_text": {"type": "string"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
